#!/bin/bash
# omx — TUI manager for omarchy-extensions.
# Extensions own the how (install.sh/uninstall.sh/status.sh); this fans out.
#
#   omx                  # interactive TUI (gum, with select fallback)
#   omx list             # table of extensions + state
#   omx install <name> [--yes]
#   omx uninstall <name> [--yes]
#   omx status <name>
set -euo pipefail

SRC="${BASH_SOURCE[0]}"
# Follow symlinks (e.g. ~/.local/bin/omx -> repo) so EXT_DIR always resolves.
if command -v readlink >/dev/null 2>&1; then
  SRC="$(readlink -f "$SRC")"
fi
OMX_ROOT="$(cd -- "$(dirname -- "$SRC")" && pwd)"
EXT_DIR="$OMX_ROOT/extensions"
HAVE_GUM=0
command -v gum >/dev/null 2>&1 && HAVE_GUM=1

die() { echo "omx: $*" >&2; exit 1; }

# --- style helpers (plain text when gum is missing) ---
ACCENT=99
GREEN=82
RED=196
DIM=245

sty() { # fg text
  if (( HAVE_GUM )); then gum style --foreground "$1" "$2"; else printf '%s' "$2"; fi
}

banner() {
  if (( HAVE_GUM )); then
    gum style --border rounded --border-foreground $ACCENT --padding "0 2" --margin "0 0 1 0" \
      "$(gum style --foreground $ACCENT --bold '✳ omarchy-extensions')  $(gum style --faint 'collectors · programs · customizations')"
  else
    echo "== omarchy-extensions =="
  fi
}

state_badge() { # raw-state -> colored short badge
  if [[ $1 == installed* ]]; then
    sty $GREEN "● $1"
  else
    sty $DIM "○ $1"
  fi
}

extensions() {
  local d
  for d in "$EXT_DIR"/*/; do
    [[ -f ${d}meta.sh ]] || continue
    basename "$d"
  done | sort
}

meta() { # name VAR -> prints value of VAR from meta.sh
  ( # subshell: sourcing must not leak
    set -a
    # shellcheck disable=SC1090
    source "$EXT_DIR/$1/meta.sh"
    printf '%s' "${!2:-}"
  )
}

state_of() { # name -> one line, never fails
  local out
  if out=$("$EXT_DIR/$1/status.sh" 2>/dev/null); then
    printf '%s' "$out"
  else
    echo "not installed"
  fi
}

cmd_list() {
  local n st
  printf '%-28s %-24s %s\n' "NAME" "KIND" "STATE"
  for n in $(extensions); do
    st=$(state_of "$n")
    if (( HAVE_GUM )) && [[ -t 1 ]]; then
      printf '%-28s %-24s %s\n' "$n" "$(meta "$n" KIND)" "$(state_badge "$st")"
    else
      printf '%-28s %-24s %s\n' "$n" "$(meta "$n" KIND)" "$st"
    fi
  done
}

run_hook() { # name hook [hook-args...]
  local name=$1 hook=$2
  shift 2
  local script="$EXT_DIR/$name/$hook.sh"
  [[ -x $script ]] || die "$name has no executable $hook.sh"
  "$script" "$@"
}

# Extra args (besides --yes, which omx consumes) are forwarded to the hook,
# e.g. `omx install apple-calendar --swap-clock`.
cmd_install() { # name [hook-args...] [--yes]
  local name=$1 hook_args=() yes=0 a
  shift
  for a in "$@"; do
    if [[ $a == "--yes" ]]; then yes=1; else hook_args+=("$a"); fi
  done
  [[ -f $EXT_DIR/$name/meta.sh ]] || die "unknown extension: $name"
  if (( ! yes )); then
    if (( HAVE_GUM )); then
      gum confirm "Install $name?" || die "aborted"
    else
      read -rp "Install $name? [y/N] " ans
      [[ $ans == [yY]* ]] || die "aborted"
    fi
  fi
  run_hook "$name" install "${hook_args[@]}"
}

cmd_uninstall() { # name [hook-args...] [--yes]
  local name=$1 hook_args=() yes=0 a
  shift
  for a in "$@"; do
    if [[ $a == "--yes" ]]; then yes=1; else hook_args+=("$a"); fi
  done
  [[ -f $EXT_DIR/$name/meta.sh ]] || die "unknown extension: $name"
  if (( ! yes )); then
    if (( HAVE_GUM )); then
      gum confirm "Uninstall $name? (removes its files + state)" || die "aborted"
    else
      read -rp "Uninstall $name? [y/N] " ans
      [[ $ans == [yY]* ]] || die "aborted"
    fi
  fi
  run_hook "$name" uninstall "${hook_args[@]}"
}

tui() {
  local names=() display=() n pick action desc st out
  for n in $(extensions); do
    names+=("$n")
    desc=$(meta "$n" DESC)
    st=$(state_of "$n")
    if (( HAVE_GUM )); then
      display+=("$n — $desc $(state_badge "$st")")
    else
      display+=("$n  [$(meta "$n" KIND)] — $st")
    fi
  done
  [[ ${#names[@]} -gt 0 ]] || die "no extensions found in $EXT_DIR"

  if (( HAVE_GUM )); then
    banner
    pick=$(printf '%s\n' "${display[@]}" | gum choose --cursor "➜ " \
      --cursor.foreground "$ACCENT" --header "$(sty $DIM 'Select extension')") || exit 0
    n=${pick%% — *}
    action=$(printf 'Install\nUninstall\nStatus\n' | gum choose --cursor "➜ " \
      --cursor.foreground "$ACCENT" --header "$(sty $DIM "$n — pick action")") || exit 0
  else
    banner
    select pick in "${display[@]}"; do n=${pick%%  *}; break; done
    select action in Install Uninstall Status; do break; done
  fi

  case $action in
    Install*)
      if (( HAVE_GUM )); then
        gum confirm --affirmative "Install" --negative "Cancel" \
          "Install $n? ($(meta "$n" DESC))" || { sty $DIM "cancelled"; echo; exit 0; }
        out=$(mktemp)
        if gum spin --spinner globe --title "Installing $n…" \
            -- "$EXT_DIR/$n/install.sh" >"$out" 2>&1; then
          gum style --foreground $GREEN --bold "✓ $n installed"
          sty $DIM "  $(state_of "$n")"; echo
        else
          gum style --foreground $RED --bold "✗ install failed"
          cat "$out"
        fi
        rm -f "$out"
      else
        cmd_install "$n"
      fi
      ;;
    Uninstall*)
      if (( HAVE_GUM )); then
        gum confirm --affirmative "Uninstall" --negative "Keep" \
          "Uninstall $n? Removes its files + state." || { sty $DIM "cancelled"; echo; exit 0; }
        out=$(mktemp)
        if gum spin --spinner globe --title "Uninstalling $n…" \
            -- "$EXT_DIR/$n/uninstall.sh" >"$out" 2>&1; then
          gum style --foreground $GREEN --bold "✓ $n uninstalled"
        else
          gum style --foreground $RED --bold "✗ uninstall failed"
          cat "$out"
        fi
        rm -f "$out"
      else
        cmd_uninstall "$n"
      fi
      ;;
    Status*)
      if (( HAVE_GUM )); then
        gum style --border rounded --border-foreground $ACCENT --padding "0 2" --margin "1 0" \
          "$(gum style --bold "$n")" "$(sty $DIM "$(meta "$n" KIND) · v$(meta "$n" VERSION)")" \
          "$(state_badge "$(state_of "$n")")"
      else
        state_of "$n"
      fi
      ;;
    *) die "unknown action: $action" ;;
  esac
}

case ${1:-tui} in
  tui) tui ;;
  list) cmd_list ;;
  install) [[ -n ${2:-} ]] || die "usage: omx install <name> [hook-args...] [--yes]"; n=$2; shift 2; cmd_install "$n" "$@" ;;
  uninstall) [[ -n ${2:-} ]] || die "usage: omx uninstall <name> [hook-args...] [--yes]"; n=$2; shift 2; cmd_uninstall "$n" "$@" ;;
  status) [[ -n ${2:-} ]] || die "usage: omx status <name>"; state_of "$2" ;;
  -h|--help|help) sed -n '2,10p' "$0" ;;
  *) die "unknown command: $1 (try: omx, list, install, uninstall, status)" ;;
esac
